<nav class="lang-switcher" aria-label="言語切り替え">
  {%- for l in site.languages %}
    {%- if not loop.first %}<span class="lang-switcher__sep">/</span>{% endif %}
    {#- 章ページでは同じ slug の別言語版へ。訳が未生成の章では目次に戻す。 -#}
    {%- set peers = collections.chaptersJa if l.code == "ja" else collections.chaptersEn %}
    {%- set peer = peers | findBySlug(slug) %}
    <a
      class="lang-switcher__item{% if l.code == lang %} is-active{% endif %}"
      href="{{ peer.url if peer else l.home }}"
      hreflang="{{ l.code }}"
    >{{ l.short }}</a>
  {%- endfor %}
</nav>
